# Copy this file to .env and set the password for your local PostgreSQL user.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@127.0.0.1:5432/app_db

# Local development only. Set to false to skip automatic demo data seeding.
UZON_DEMO_MODE=true
SEED_ON_BOOT=true

# Required only when the separate FFmpeg HLS worker is deployed.
VIDEO_WORKER_TOKEN=replace-with-a-long-random-secret
